# REDACTED EXAMPLE — the real, full config lives in the PRIVATE Homelab repo:
#   Infrastructure/SSH/ssh-config   (workstation ~/.ssh/config symlinks to it)
# New-machine bootstrap: Infrastructure/SSH/install.sh in the Homelab repo.
# Values in <ANGLE_BRACKETS> come from the Homelab repo / Proton Pass.

# Bastion HA — OpenBao-CA cert auth. The `Match exec` re-signs the cert via
# bastion-cert-refresh, so `ssh bastion` is a one-command login.
Host bastion <BASTION_FQDN> <BASTION_VIP>
    HostName <BASTION_FQDN>
    User <USER>
    IdentityFile ~/.ssh/id_bastion
    IdentitiesOnly yes

Match host "bastion,<BASTION_FQDN>,<BASTION_VIP>" exec "%d/.local/bin/bastion-cert-refresh"
    CertificateFile ~/.ssh/id_bastion-cert.pub

# Hetzner VPS — resume deploy target (brandonkitlo.com)
# Use this key automatically for the VPS so `ssh root@<VPS_IP>` / `ssh vps`
# work without `-i`. IdentitiesOnly ensures only this key is offered.
Host <VPS_IP> vps
    HostName <VPS_IP>
    User root
    IdentityFile ~/.ssh/id_ed25519_bklo
    IdentitiesOnly yes

# Homelab LAN — root + default key.
# IdentitiesOnly: SSH_AUTH_SOCK points at the Proton Pass SSH agent, which
# serves several keys; offering them all first trips MaxAuthTries (6) on
# servers. This pins every LAN connection to a single offered identity.
# NOTE first-match-wins ordering: specific Host blocks (bastion, legacy-crypto
# devices) must sit ABOVE this wildcard block.
Host <LAN_SUBNET_1>.* <LAN_SUBNET_2>.*
    User root
    IdentityFile ~/.ssh/id_ed25519
    IdentitiesOnly yes
