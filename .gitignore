# secrets never enter the repo (zshrc sources ~/.secrets.zsh from outside)
.secrets*
*.env
*-token*
credentials*
# transient editor/app backups
*.backup-*
*~
*.bak

# app state / caches / binaries must never enter the repo
# (2026-09-04: WebCord+spotify app state had to be purged from history — don't repeat)
*.log
*.zip
*.exe
*.sqlite*
*.db
*cookie*
Cache/
Code Cache/
GPUCache/

# live claude settings contain API tokens — only the .example ships
# (repo-level too — the global ignore is stowed from here, so a fresh
# clone pre-stow must not be able to `git add .` these)
**/.claude/settings.json
**/.claude/settings.local.json
# ssh: only config/allowed_signers/*.pub ever ship; never keys or host state
Linux/ssh/.ssh/id_*
!Linux/ssh/.ssh/*.pub
Linux/ssh/.ssh/known_hosts*
Linux/ssh/.ssh/authorized_keys*
