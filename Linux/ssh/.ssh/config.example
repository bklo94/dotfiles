# Hetzner VPS — resume deploy target (brandonkitlo.com)
# Use this key automatically for the VPS so `ssh root@<VPS_IP>` / `ssh vps`
# work without `-i`. IdentitiesOnly ensures only this key is offered.
Host <VPS_IP> vps
    HostName <VPS_IP>
    User root
    IdentityFile ~/.ssh/id_ed25519_bklo
    IdentitiesOnly yes

# --- Multi-key agents (Proton Pass loads 5 keys): pin per host or servers
# --- hit MaxAuthTries ("Too many authentication failures").
# --- Agent-only keys can be pinned by pointing IdentityFile at the PUBLIC key:
# ---   ssh-add -L | grep <comment> > ~/.ssh/keys/<name>.pub

# Bastion VIP (keepalived+haproxy, VMs 10.0.0.35/.36) — FIDO2 key only.
# Private key lives on the hardware token; on a new machine run
# `ssh-keygen -K` to pull resident keys, then ssh bastion (passphrase + touch).
Host bastion bastion.homelab.brandonkitlo.com 10.0.0.6
    IdentitiesOnly yes
    IdentityFile ~/.ssh/id_ed25519_sk
