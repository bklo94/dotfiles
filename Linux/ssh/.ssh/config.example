# Hetzner VPS — resume deploy target (brandonkitlo.com)
# Use this key automatically for the VPS so `ssh root@<VPS_IP>` / `ssh vps`
# work without `-i`. IdentitiesOnly ensures only this key is offered.
Host <VPS_IP> vps
    HostName <VPS_IP>
    User root
    IdentityFile ~/.ssh/id_ed25519_bklo
    IdentitiesOnly yes
