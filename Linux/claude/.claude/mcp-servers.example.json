{
  "sonarqube": {
    "args": [
      "run",
      "mcp"
    ],
    "command": "sonar"
  },
  "web-search-prime": {
    "headers": {
      "Authorization": "Bearer ${Z_AI_API_KEY}"
    },
    "type": "http",
    "url": "https://api.z.ai/api/mcp/web_search_prime/mcp"
  },
  "zai-mcp-server": {
    "args": [
      "-y",
      "@z_ai/mcp-server"
    ],
    "command": "npx",
    "env": {
      "Z_AI_API_KEY": "${Z_AI_API_KEY}",
      "Z_AI_MODE": "ZAI"
    },
    "type": "stdio"
  }
}
