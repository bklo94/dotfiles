# secrets.zsh.example — committed template (safe; NO real values)
#
# This documents the environment variables your shell and tools expect.
# Put the REAL values in ~/.zshrc.local — that file is sourced by ~/.zshrc
# and lives OUTSIDE the git repo, so secrets are never committed.
#
#   cp ~/.config/zsh/secrets.zsh.example ~/.zshrc.local
#   # then edit ~/.zshrc.local and fill in real values, then:
#   chmod 600 ~/.zshrc.local

# --- AI / LLM (aider, claude, etc.) ---
# export OPENAI_API_KEY="sk-..."
# export ANTHROPIC_API_KEY="sk-ant-..."

# --- Source control ---
# export GITHUB_TOKEN="ghp-..."
# export GITLAB_TOKEN="glpat-..."

# --- Cloud ---
# export AWS_ACCESS_KEY_ID="..."
# export AWS_SECRET_ACCESS_KEY="..."
# export AWS_DEFAULT_REGION="us-east-1"

# --- Machine-specific PATH (non-portable binaries) ---
# export PATH="$PATH:$HOME/.local/bin-private"
